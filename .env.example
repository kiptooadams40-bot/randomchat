# ─────────────────────────────────────────────────────────────────────────────
# RandomChat environment. Copy to .env.local for local dev; set the same keys
# in Vercel → Project → Settings → Environment Variables for deployment.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Only controls whether the "Dev mode: self-declared check" note is shown on the
# age check. Set to "production" on the live site.
NEXT_PUBLIC_APP_ENV=development
# Your https site URL. Set it in Production only; leave it unset on Preview so
# PesaPal callbacks go to the preview deployment itself.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase: Auth + Postgres + Realtime ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New keys (preferred): sb_publishable_... and sb_secret_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Legacy keys (still accepted while you migrate; used only if the two above are unset):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes.
CRON_SECRET=CHANGE_ME_RANDOM_32_CHARS

# ── WebRTC: Cloudflare Realtime TURN (STUN is stun.cloudflare.com) ──────────
# The API token never reaches the browser: /api/ice turns it into short-lived
# credentials. Without these the app works STUN-only (mobile data often fails).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ── Payments: PesaPal API v3 ────────────────────────────────────────────────
# live (https://pay.pesapal.com/v3) is the default; "sandbox" uses PesaPal's demo
# environment with sandbox keys (https://cybqa.pesapal.com/pesapalv3).
PESAPAL_ENV=live
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Optional override. Normally leave empty: the app registers <site>/api/billing/ipn
# once and stores the notification_id in the database.
PESAPAL_IPN_ID=

# ── Analytics (optional). Loads only after the visitor accepts cookies. ─────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
