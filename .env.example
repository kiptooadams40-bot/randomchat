# ─────────────────────────────────────────────────────────────────────────────
# RandomChat environment. Copy to .env.local for local dev; set the same keys
# in Vercel → Project → Settings → Environment Variables for deployment.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# development | staging | production
# Mock age checks, mock moderation and the mock payment gateway are REFUSED
# when APP_ENV=production. The app fails closed rather than letting users
# chat behind a fake age check.
APP_ENV=development
# Only controls whether dev controls are *shown*. The server enforces APP_ENV.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (free tier): Auth + Postgres + Realtime + Storage ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── Upstash Redis (free tier): matching queue, rate limits, locks ───────────
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# Random 32+ char strings. IP addresses are only ever stored as salted hashes.
IP_HASH_SALT=CHANGE_ME_RANDOM_32_CHARS
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes.
CRON_SECRET=CHANGE_ME_RANDOM_32_CHARS

# ── Cloudflare Turnstile (free). These are Cloudflare's official TEST keys
# (always pass). Replace with real keys before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── WebRTC ICE ──────────────────────────────────────────────────────────────
ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478
# Optional. Leave empty for STUN-only (free). Without TURN, users behind
# symmetric NAT / mobile carrier-grade NAT will fail to connect.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Age assurance ───────────────────────────────────────────────────────────
# mock | yoti   (mock is refused in production)
AGE_PROVIDER=mock
YOTI_CLIENT_SDK_ID=
YOTI_PEM_KEY=

# ── Content moderation ──────────────────────────────────────────────────────
# mock | sightengine   (mock is refused in production)
MODERATION_PROVIDER=mock
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# none | safer | photodna   (hash-matching access requires vendor approval)
CSAM_PROVIDER=none
SAFER_API_KEY=
PHOTODNA_SUBSCRIPTION_KEY=

# ── VPN / proxy / Tor detection ─────────────────────────────────────────────
# none | proxycheck   (proxycheck.io has a free daily quota)
VPN_PROVIDER=none
PROXYCHECK_API_KEY=

# ── Payments ────────────────────────────────────────────────────────────────
# Stripe TEST mode keys (sk_test_..., whsec_...). No charges happen in test mode.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Pesapal API 3.0. sandbox | live
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Optional: pre-registered IPN id. If empty, the app registers one on first use.
PESAPAL_IPN_ID=

# PayPal REST. sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Billing plans created once in the PayPal dashboard (price is overridden per checkout).
PAYPAL_PLAN_ID_WEEKLY=
PAYPAL_PLAN_ID_FORTNIGHTLY=
PAYPAL_PLAN_ID_MONTHLY=

# ── Email (renewal reminders). Resend free tier. Empty = log to console. ────
RESEND_API_KEY=
EMAIL_FROM=RandomChat <no-reply@example.com>

# ── Analytics (optional). Loads only after the visitor accepts cookies. ─────
# Replace with your Google Analytics 4 measurement ID.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
